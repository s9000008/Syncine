# Syncine 系統環境變數範例配置
# 請複製此檔案並重新命名為 .env 使用

# 後端伺服器通訊埠 (Port，對齊 Fly.io 線上部署預設 8080)
PORT=8080

# 後端伺服器全域最大同時存在房間數上限 (防範 256MB 容器記憶體耗竭)
MAX_ROOMS=1000

# 預設官方連線伺服器網址 (前端 Extension 預設連線位置)
VITE_DEFAULT_SERVER_URL=https://syncine.fly.dev

# 跨域請求 CORS 允許來源 (可使用逗號分隔多個網址)
CORS_ORIGIN=*

# 日誌等級 (debug | info | warn | error)
LOG_LEVEL=info
