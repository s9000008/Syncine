{
  "name": "syncine-server",
  "version": "2.9.0",
  "description": "Syncine Video Sync WebSocket Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && ts-node -P tsconfig.json --transpile-only test_suite.ts && node test_security_p1.mjs && node test_security_cve.mjs",
    "security:check": "node ../.agents/skills/security-agent/scripts/scan_secrets.js"
  },
  "keywords": [
    "syncine",
    "sync-play",
    "websocket",
    "socket.io"
  ],
  "author": "Syncine Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1 || >=22.23.4 || >=24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
