{
  "manifest_version": 3,
  "name": "Syncine (同映) - 跨平台影片同步播放",
  "version": "2.1.0",
  "description": "跨地理位置、跨網頁即時低延遲影片同步播放套件 (支援 YouTube, Bilibili)",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.bilibili.com/*",
    "https://syncine.fly.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/play/*"
      ],
      "js": ["src/content/index.ts"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Syncine (同映) 控制面板"
  }
}
