      ],
      "js": [
        "src/content/index.ts"
      ],
      "all_frames": false,
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.netflix.com/watch*"
      ],
      "js": [
        "src/content/netflix_bridge.ts"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "__MSG_actionTitle__"
  }
